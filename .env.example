# Chave da Groq (obtenha gratuitamente em https://console.groq.com)
GROQ_API_KEY=sua_chave_aqui

# Porta para o servidor (o Render injeta a porta automaticamente via PORT)
PORT=8000

# Voz para o TTS Edge (opções: pt-BR-AntonioNeural, pt-BR-FranciscaNeural, en-GB-RyanNeural)
TTS_VOICE=pt-BR-AntonioNeural
